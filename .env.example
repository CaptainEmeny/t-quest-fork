# Gemini (Google AI Studio -> Get API key). Used by the Mastra quest agent.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model
GEMINI_MODEL=google/gemini-2.5-flash
# Tiger Data Postgres connection string. Leave blank to use data/places.json
DATABASE_URL=
# Optional: MBTA v3 API key (works without one, just lower rate limit)
MBTA_API_KEY=

DATABASE_URL=

PORT=3000